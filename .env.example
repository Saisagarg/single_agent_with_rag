AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_CHAT_DEPLOYMENT=YOUR-EXISTING-CHAT-DEPLOYMENT
AZURE_EMBEDDING_DEPLOYMENT=YOUR-EXISTING-EMBEDDING-DEPLOYMENT
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_INDEX=YOUR-EXISTING-INDEX
AZURE_SEARCH_API_KEY=REPLACE-ME
AZURE_STORAGE_ACCOUNT=YOUR-EXISTING-STORAGE-ACCOUNT
AZURE_BLOB_CONTAINER=YOUR-EXISTING-CONTAINER
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE-ME
NEO4J_DATABASE=neo4j
# Local Python defaults to cli. Compose selects default automatically.
# For local containers, supply an authorized service principal:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# In Azure hosting, use managed identity instead of a client secret.
